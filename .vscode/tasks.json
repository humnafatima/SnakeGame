{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Snake Game (g++)",
            "type": "shell",
            "command": "g++",
            "args": [
                "src/Food.cpp",
                "src/GameController.cpp",
                "src/main.cpp",
                "src/Obstacle.cpp",
                "src/Snake.cpp",
                "-o",
                "build/SnakeGame",
                "-I",
                "include",
                "-I",
                "external/Raylib/include",
                "-L",
                "external/Raylib/lib",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}