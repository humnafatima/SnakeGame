{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Current File (Raylib)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-I${workspaceFolder}/raylib/include",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe",
                "-L${workspaceFolder}/raylib/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-lm",
                "-mwindows"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}